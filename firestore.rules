rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function author() { return request.auth != null && request.auth.uid == 'Hmnk75jRmwZBfKNjDT2sKkzp5b22'; }
    match /books/{bookId}/chapters/{chapterId} {
      allow read: if true;
      function valid() {
        return request.resource.data.keys().hasAll(['title', 'paragraphs', 'revision', 'updatedAt', 'updatedBy'])
          && request.resource.data.keys().hasOnly(['title', 'paragraphs', 'revision', 'updatedAt', 'updatedBy'])
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
          && request.resource.data.paragraphs is list && request.resource.data.paragraphs.size() > 0
          && request.resource.data.revision is int
          && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid;
      }
      allow create: if author() && valid() && request.resource.data.revision == 1;
      allow update: if author() && valid() && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
